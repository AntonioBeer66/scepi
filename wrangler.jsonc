// Site www.scepinvaders.com sur Cloudflare Workers, avec la coinche en ligne et
// les actus dans un Durable Object (worker/tables.js).
//   npm start                                (local : http://localhost:8000)
//   npx wrangler login                       (une fois, dans le navigateur)
//   npx wrangler secret put ARTICLES_PASSWORD (une fois : publier/modifier les actus)
//   npm run deploy
{
  "name": "scepi",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "scepinvaders.com", "custom_domain": true },
    { "pattern": "www.scepinvaders.com", "custom_domain": true },
  ],
  "assets": {
    // site/ plus une copie de src/echecs (site/src/echecs, faite par npm run build).
    "directory": "site",
    "binding": "ASSETS",
    // Seule l'API passe par le Worker ; les fichiers sont servis sans lui.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "Tables" }],
  },
  // Stockage SQLite : celui de l'offre gratuite des Durable Objects. Le
  // journal y a vécu une journée (v2) avant de passer dans D1 (v3).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tables"] },
    { "tag": "v2", "new_sqlite_classes": ["Journal"] },
    { "tag": "v3", "deleted_classes": ["Journal"] },
  ],
  // Journal anonyme des donnes jouées par des humains (worker/journal.js) :
  // le site y écrit seulement ; on le lit avec son compte Cloudflare
  //   npx wrangler d1 execute scepi-journal --remote --json --command "SELECT …"
  // (table créée une fois : CREATE TABLE donnes (id INTEGER PRIMARY KEY
  // AUTOINCREMENT, data TEXT NOT NULL)). La version de test n'en a pas.
  "d1_databases": [
    {
      "binding": "JOURNAL_DB",
      "database_name": "scepi-journal",
      "database_id": "e20ccb96-a2a8-4566-bc81-cd2df578d31c",
    },
  ],
  // Version de test (npm run deploy:staging) : scepi-staging.<compte>.workers.dev,
  // avec ses propres tables et actus ; son mot de passe des actus se règle à part
  // (npx wrangler secret put ARTICLES_PASSWORD --env staging).
  "env": {
    "staging": {
      "name": "scepi-staging",
      "routes": [],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "TABLES", "class_name": "Tables" }],
      },
    },
  },
}
